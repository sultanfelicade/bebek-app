###############################################
# ENV PUSAT — Windows (Laragon / XAMPP)
# Copy file ini ke .env jika menjalankan sebagai PUSAT
# cp .env.pusat .env
###############################################

APP_NAME=Laravel_Pusat
APP_ENV=local
APP_KEY=base64:0UELgBfX9r8HBzOryQxtFtCDBWxGZZw2BQu55N/AnSo=
APP_DEBUG=true
APP_URL=http://192.168.1.5:8000

# Identitas Node
NODE_TYPE=pusat
BRANCH_ID=0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################
# DATABASE UTAMA PUSAT
# Opsi 1: Pakai MySQL Laragon lokal → DB_CONNECTION=mysql
# Opsi 2: Nebeng MySQL VM Linux   → DB_CONNECTION=mysql_vm_linux
###############################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_bebek_wien
DB_USERNAME=root
DB_PASSWORD=
FALLBACK_DB_CONNECTION=mysql_vm_linux

###############################################
# KONEKSI KE DATABASE CABANG (VM Linux)
# Untuk sinkronisasi data pusat ↔ cabang
# IP tetap via Host-Only Adapter, tidak berubah meski ganti jaringan
###############################################
VM_DB_HOST=192.168.56.102
VM_DB_PORT=3306
VM_DB_DATABASE=cabang
VM_DB_USERNAME=root
VM_DB_PASSWORD=Purwoasri06

###############################################
# SINKRONISASI & FAILOVER
# CENTRAL_BASE_URL  = API endpoint pusat (diri sendiri)
# CABANG_API_URL    = API endpoint cabang (untuk push data ke cabang)
# SYNC_KEY          = Shared secret untuk autentikasi sync antar node
###############################################
CENTRAL_BASE_URL=${APP_URL}
CABANG_API_URL=http://192.168.56.102:8000/api
CENTRAL_SYNC_KEY=bebek-wien-sync-secret-2026

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
