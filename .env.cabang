###############################################
# ENV CABANG — VM Linux
# Copy file ini ke .env jika menjalankan sebagai CABANG
# cp .env.cabang .env
###############################################

APP_NAME=Laravel_Cabang_1
APP_ENV=local
APP_KEY=base64:W9SRowujY7RydNXTlI/QxDjzQz5h1c5RrHDKPzpWjvo=
APP_DEBUG=true
APP_URL=http://192.168.1.14:8000

# Identitas Node Cabang & Endpoint API Pusat
NODE_TYPE=cabang
BRANCH_ID=1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################
# DATABASE UTAMA CABANG (VM Linux)
###############################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cabang
DB_USERNAME=cabang_user
DB_PASSWORD=Purwoasri06
FALLBACK_DB_CONNECTION=mysql_pusat

###############################################
# KONEKSI KE DATABASE PUSAT (Windows)
# Untuk sinkronisasi darurat jika API pusat down
# Pastikan MySQL Laragon di-bind ke 0.0.0.0
###############################################
PUSAT_DB_HOST=192.168.56.1
PUSAT_DB_PORT=3306
PUSAT_DB_DATABASE=db_bebek_wien
PUSAT_DB_USERNAME=root
PUSAT_DB_PASSWORD=

###############################################
# SINKRONISASI & FAILOVER
# PUSAT_API_URL     = Endpoint API server pusat (Windows)
# CENTRAL_BASE_URL  = Base URL pusat
# CENTRAL_SYNC_KEY  = Shared secret (harus sama dengan pusat)
###############################################
PUSAT_API_URL=http://192.168.56.1:8000/api
CENTRAL_BASE_URL=http://192.168.56.1:8000
CENTRAL_SYNC_KEY=bebek-wien-sync-secret-2026

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
